generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  passwordHash           String
  currency               String                  @default("INR")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categories             Category[]
  imports                Import[]
  merchants              Merchant[]
  monthlyReports         MonthlyReport[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  spendingRules          SpendingRule[]
  transactions           Transaction[]
}

model Import {
  id               Int           @id @default(autoincrement())
  userId           Int
  fileName         String
  fileType         String
  status           ImportStatus  @default(PENDING)
  transactionCount Int           @default(0)
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contentHash      String?
  user             User          @relation(fields: [userId], references: [id])
  transactions     Transaction[]

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

model Transaction {
  id              Int                     @id @default(autoincrement())
  userId          Int
  importId        Int?
  merchantId      Int?
  categoryId      Int?
  amount          Decimal
  type            TransactionType
  description     String?
  normalizedDesc  String?
  transactionDate DateTime
  transactionTime DateTime?
  classification  SpendingClassification?
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  category        Category?               @relation(fields: [categoryId], references: [id])
  import          Import?                 @relation(fields: [importId], references: [id])
  merchant        Merchant?               @relation(fields: [merchantId], references: [id])
  user            User                    @relation(fields: [userId], references: [id])

  @@index([userId, transactionDate])
  @@index([userId, merchantId])
  @@index([userId, categoryId])
  @@index([importId])
}

model Merchant {
  id                Int                     @id @default(autoincrement())
  userId            Int
  name              String
  rawPatterns       String[]
  defaultCategoryId Int?
  classification    SpendingClassification?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  defaultCategory   Category?               @relation(fields: [defaultCategoryId], references: [id])
  user              User                    @relation(fields: [userId], references: [id])
  spendingRules     SpendingRule[]
  transactions      Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id             Int                     @id @default(autoincrement())
  userId         Int
  name           String
  icon           String?
  color          String?
  type           TransactionType
  classification SpendingClassification?
  isSystem       Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id])
  merchants      Merchant[]
  spendingRules  SpendingRule[]
  transactions   Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model SpendingRule {
  id             Int                     @id @default(autoincrement())
  userId         Int
  pattern        String
  merchantId     Int?
  categoryId     Int?
  classification SpendingClassification?
  priority       Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  category       Category?               @relation(fields: [categoryId], references: [id])
  merchant       Merchant?               @relation(fields: [merchantId], references: [id])
  user           User                    @relation(fields: [userId], references: [id])

  @@index([userId, priority])
}

model MonthlyReport {
  id                Int      @id @default(autoincrement())
  userId            Int
  year              Int
  month             Int
  totalIncome       Decimal
  totalExpense      Decimal
  categoryBreakdown Json
  merchantBreakdown Json
  patterns          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model NotificationPreference {
  userId                  Int      @id
  monthlyReminderEnabled  Boolean  @default(true)
  reportReadyEnabled      Boolean  @default(true)
  recurringPaymentEnabled Boolean  @default(false)
  reminderDay             Int      @default(25)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  href      String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model RateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  attempts        Int      @default(1)
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpendingClassification {
  ESSENTIAL
  USEFUL
  DISCRETIONARY
  CUSTOM
}

enum NotificationType {
  MONTHLY_REMINDER
  REPORT_READY
  RECURRING_PAYMENT
}
