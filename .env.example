# PostgreSQL connection used by the application and Prisma CLI.
DATABASE_URL="postgresql://postgres:password@localhost:5432/money_autopsy?schema=public"

# Generate at least 32 random bytes for production. Never commit the real value.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional: INR amount below which purchases are grouped as small purchases.
SMALL_PURCHASE_THRESHOLD="200"

# Optional: enables the opt-in AI report explanation.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Optional. Use a dedicated disposable database; the isolation test writes and deletes fixture rows.
TEST_DATABASE_URL=""
